PORT=3004
NODE_ENV=development

DATABASE_URL=postgresql://orderflow:orderflow@localhost:5433/orderflow_payment?sslmode=disable

KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=payment-service
KAFKA_INVENTORY_RESERVED_TOPIC=inventory.reserved
KAFKA_PAYMENT_SUCCEEDED_TOPIC=payment.succeeded
KAFKA_PAYMENT_FAILED_TOPIC=payment.failed

# demo: always succeed unless set to false
PAYMENT_SIMULATE_SUCCESS=true

RABBITMQ_URL=amqp://orderflow:orderflow@localhost:5672/
RABBITMQ_EXCHANGE=orderflow.notifications

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=5
OUTBOX_DLQ_TOPIC=dlq.outbox

OTEL_ENABLED=false
OTEL_SERVICE_NAME=payment-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
