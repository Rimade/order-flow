PORT=3003
NODE_ENV=development

DATABASE_URL=postgresql://orderflow:orderflow@localhost:5433/orderflow_inventory?sslmode=disable

KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=inventory-service
KAFKA_ORDER_TOPIC=order.created
KAFKA_INVENTORY_RESERVED_TOPIC=inventory.reserved
KAFKA_INVENTORY_REJECTED_TOPIC=inventory.rejected

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=5
OUTBOX_DLQ_TOPIC=dlq.outbox

KAFKA_PAYMENT_FAILED_TOPIC=payment.failed
KAFKA_PAYMENT_FAILED_CONSUMER_GROUP=inventory-service-compensation

OTEL_ENABLED=false
OTEL_SERVICE_NAME=inventory-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
