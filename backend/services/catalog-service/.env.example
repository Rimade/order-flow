PORT=3006
NODE_ENV=development

DATABASE_URL=postgresql://orderflow:orderflow@localhost:5433/orderflow_catalog

# memory | redis — default redis (same instance as gateway rate limit)
CACHE_STORE=redis
REDIS_URL=redis://localhost:6379

# Cache TTL (ms) for product list/detail
CACHE_TTL_MS=60000

# Первый запуск: npm run prisma:migrate
