PORT=3002
NODE_ENV=development

DATABASE_URL=postgresql://orderflow:orderflow@localhost:5433/orderflow_order

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-service
KAFKA_CONSUMER_GROUP=order-service
KAFKA_ORDER_TOPIC=order.created
KAFKA_INVENTORY_RESERVED_TOPIC=inventory.reserved
KAFKA_INVENTORY_REJECTED_TOPIC=inventory.rejected
KAFKA_PAYMENT_SUCCEEDED_TOPIC=payment.succeeded
KAFKA_PAYMENT_FAILED_TOPIC=payment.failed

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=5
OUTBOX_DLQ_TOPIC=dlq.outbox

# Idempotency-Key for POST /orders (Redis). Set IDEMPOTENCY_ENABLED=false to disable.
IDEMPOTENCY_ENABLED=true
REDIS_URL=redis://localhost:6379
IDEMPOTENCY_TTL_SECONDS=86400

OTEL_ENABLED=false
OTEL_SERVICE_NAME=order-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
